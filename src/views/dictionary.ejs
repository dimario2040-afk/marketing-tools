<div class="glossary">
  <h1 class="glossary__title"><%= t('dictionary.title') %></h1>
  <p class="glossary__intro"><%= t('dictionary.intro') %></p>

  <% var terms = [
    { id: 'api', label: 'API' },
    { id: 'bounce', label: 'Bounce Rate' },
    { id: 'cpa', label: 'CPA' },
    { id: 'cpc', label: 'CPC' },
    { id: 'cpm', label: 'CPM' },
    { id: 'crm', label: 'CRM' },
    { id: 'ctr', label: 'CTR' },
    { id: 'cvr', label: 'CVR' },
    { id: 'dau_mau', label: 'DAU / MAU' },
    { id: 'heat', label: 'HEAT' },
    { id: 'kpi', label: 'KPI' },
    { id: 'ltv', label: 'LTV / CLV' },
    { id: 'ppc', label: 'PPC' },
    { id: 'roas', label: 'ROAS' },
    { id: 'roi', label: 'ROI' },
    { id: 'sem', label: 'SEM' },
    { id: 'seo', label: 'SEO' },
    { id: 'serp', label: 'SERP' },
    { id: 'utm', label: 'UTM' }
  ]; %>

  <% terms.forEach(function(term) { %>
    <% var data = t('dictionary.' + term.id); %>
    <details class="glossary-term">
      <summary class="glossary-term__header">
        <span class="glossary-term__abbr"><%= term.label %></span>
        <span class="glossary-term__brief"><%= typeof data === 'object' ? data.brief : data %></span>
        <span class="glossary-term__chevron">▾</span>
      </summary>
      <div class="glossary-term__body">
        <% if (typeof data === 'object' && data.desc) { %>
          <div class="glossary-term__desc"><%= data.desc %></div>
        <% } else if (typeof data !== 'object') { %>
          <div class="glossary-term__desc"><%= data %></div>
        <% } %>
        <% if (typeof data === 'object' && data.examples && data.examples.length) { %>
        <div class="glossary-term__examples">
          <span class="glossary-examples-heading">Examples:</span>
          <ul>
            <% data.examples.forEach(function(ex) { %>
              <li><%= ex %></li>
            <% }); %>
          </ul>
        </div>
        <% } %>
      </div>
    </details>
  <% }); %>
</div>
