<script>
/* ========================= Plexus ========================= */
(function(){
  var c=document.getElementById('plexus'),hero=document.getElementById('hero');
  if(!c||!hero)return;
  var ctx=c.getContext('2d');
  var w,h,pts=[],M={x:null,y:null};
  function size(){
    var d=Math.min(2,devicePixelRatio||1);
    w=hero.offsetWidth;h=hero.offsetHeight;
    c.width=w*d;c.height=h*d;ctx.setTransform(d,0,0,d,0,0);
    var n=Math.min(110,Math.round(w*h/15000));
    pts=[];
    for(var i=0;i<n;i++)pts.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.55,vy:(Math.random()-.5)*.55});
  }
  size();addEventListener('resize',size);
  hero.addEventListener('mousemove',function(e){var r=hero.getBoundingClientRect();M.x=e.clientX-r.left;M.y=e.clientY-r.top;});
  hero.addEventListener('mouseleave',function(){M.x=M.y=null;});
  var L=120,MR=190;
  (function tick(){
    ctx.clearRect(0,0,w,h);
    var i,j,a,b,d,dx,dy;
    for(i=0;i<pts.length;i++){var p=pts[i];
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;
      if(M.x!==null){dx=p.x-M.x;dy=p.y-M.y;d=Math.hypot(dx,dy);
        if(d<MR&&d>.1){p.x+=dx/d*.6;p.y+=dy/d*.6;}}}
    for(i=0;i<pts.length;i++)for(j=i+1;j<pts.length;j++){
      a=pts[i];b=pts[j];d=Math.hypot(a.x-b.x,a.y-b.y);
      if(d<L){ctx.strokeStyle='rgba(150,200,255,'+(1-d/L)*.35+')';ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();}}
    if(M.x!==null)for(i=0;i<pts.length;i++){p=pts[i];d=Math.hypot(p.x-M.x,p.y-M.y);
      if(d<MR){ctx.strokeStyle='rgba(255,255,255,'+(1-d/MR)*.5+')';ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(M.x,M.y);ctx.stroke();}}
    for(i=0;i<pts.length;i++){p=pts[i];ctx.fillStyle='rgba(220,240,255,.9)';ctx.beginPath();ctx.arc(p.x,p.y,1.6,0,7);ctx.fill();}
    requestAnimationFrame(tick);
  })();
})();

/* ========================= Parallax ========================= */
(function(){
  var hero=document.getElementById('hero');
  if(!hero)return;
  var layers=hero.querySelectorAll('[data-depth]');
  hero.addEventListener('mousemove',function(e){
    var r=hero.getBoundingClientRect(),
        mx=(e.clientX-r.left)/r.width*2-1,my=(e.clientY-r.top)/r.height*2-1;
    layers.forEach(function(l){var d=+l.dataset.depth;l.style.transform='translate3d('+(mx*d)+'px,'+(my*d)+'px,0)';});
  });
  hero.addEventListener('mouseleave',function(){layers.forEach(function(l){l.style.transform='';});});
})();

/* ========================= Cursor glow ========================= */
(function(){
  var cur=document.getElementById('cursor');
  if(!cur)return;
  var x=innerWidth/2,y=innerHeight/2,cx=x,cy=y;
  addEventListener('mousemove',function(e){x=e.clientX;y=e.clientY;});
  (function f(){cx+=(x-cx)*.08;cy+=(y-cy)*.08;cur.style.left=cx+'px';cur.style.top=cy+'px';requestAnimationFrame(f);})();
})();

/* ========================= Counters ========================= */
function count(el){
  var t=+el.dataset.count,s=el.dataset.suffix||'',t0=performance.now();
  (function f(n){
    var p=Math.min(1,(n-t0)/1400),e=1-Math.pow(1-p,3);
    el.textContent=Math.round(t*e)+s;
    if(p<1)requestAnimationFrame(f);
  })(t0);
}

/* ========================= Reveal ========================= */
(function(){
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting)return;
      e.target.classList.add('in');
      if(e.target.hasAttribute('data-count'))count(e.target);
      io.unobserve(e.target);
    });
  },{threshold:.15});
  document.querySelectorAll('.reveal,[data-count]').forEach(function(el){io.observe(el);});
})();

/* ========================= Tilt ========================= */
document.querySelectorAll('.tilt').forEach(function(card){
  card.addEventListener('mousemove',function(e){
    var r=card.getBoundingClientRect(),
        x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
    card.style.transform='perspective(900px) rotateY('+(x*6)+'deg) rotateX('+(-y*6)+'deg) translateY(-4px)';
  });
  card.addEventListener('mouseleave',function(){card.style.transform='';});
});

/* ========================= Magnetic ========================= */
document.querySelectorAll('.magnetic').forEach(function(b){
  b.addEventListener('mousemove',function(e){
    var r=b.getBoundingClientRect();
    b.style.transform='translate('+((e.clientX-r.left-r.width/2)*.12)+'px,'+((e.clientY-r.top-r.height/2)*.25)+'px)';
  });
  b.addEventListener('mouseleave',function(){b.style.transform='';});
});

/* ========================= Search ========================= */
(function(){
  var inp=document.getElementById('toolSearch'),noRes=document.getElementById('noRes'),qEl=document.getElementById('noResQ');
  if(!inp||!noRes)return;
  var cards=[].slice.call(document.querySelectorAll('.tool')),
      secs=[].slice.call(document.querySelectorAll('.tool-sec'));
  inp.addEventListener('input',function(){
    var v=inp.value.trim().toLowerCase();
    cards.forEach(function(c){var hay=(c.dataset.search+' '+c.textContent).toLowerCase();c.classList.toggle('hide',!!v&&hay.indexOf(v)===-1);});
    var total=0;
    secs.forEach(function(s){var vis=s.querySelectorAll('.tool:not(.hide)').length;total+=vis;s.classList.toggle('hide',!!v&&vis===0);});
    noRes.classList.toggle('show',!!v&&total===0);
    if(qEl)qEl.textContent=inp.value.trim();
  });
})();

/* ========================= Playground ========================= */
(function(){
  var ta=document.getElementById('pgInput');
  if(!ta)return;
  var C=document.getElementById('mChars'),W=document.getElementById('mWords'),
      S=document.getElementById('mSent'),P=document.getElementById('mPara'),
      CY=document.getElementById('mCyr'),bar=document.getElementById('cyrBar');
  ta.addEventListener('input',function(){
    var v=ta.value;
    C.textContent=v.length;
    W.textContent=(v.trim().match(/\S+/g)||[]).length;
    S.textContent=v.split(/[.!?…]+/).filter(function(s){return s.trim();}).length;
    P.textContent=v.split(/\n+/).filter(function(s){return s.trim();}).length;
    var cyr=(v.match(/[\u0400-\u04FF]/g)||[]).length,
        pct=v.length?Math.round(cyr/v.length*100):0;
    CY.textContent=pct+'%';
    if(bar)bar.style.width=pct+'%';
  });
})();
</script>
