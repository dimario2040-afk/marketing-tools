<div class="tool-page">
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://admatic.pro", "name": "AdMatic" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://admatic.pro/html-editor", "name": "HTML Editor" } }
    ]
  }
  </script>

  <h1><%= t('tools.html_title') %></h1>
  <p class="description"><%= t('tools.html_desc') %></p>

  <div class="tool-widget">
    <div class="form-group">
      <label><%= t('tools.html_label') %></label>
      <textarea id="html-input" class="form-textarea auto-resize" rows="12" placeholder="<h1>Hello, world!</h1>"><h1>Hello, world!</h1>
<p>Start typing HTML here — the preview updates live.</p></textarea>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <button class="btn btn--primary" id="html-refresh"><%= t('tools.html_btn') %></button>
      <button class="btn btn--secondary" id="html-clear"><%= t('common.clear') %></button>
    </div>
  </div>

  <div class="tool-widget">
    <h3><%= t('tools.html_preview') %></h3>
    <div id="html-preview" class="result-box" style="min-height:200px;background:#fff;border:2px dashed var(--color-border);overflow:auto;"></div>
  </div>
</div>

<script>
function updatePreview() {
  var html = document.getElementById('html-input').value;
  document.getElementById('html-preview').innerHTML = html;
}

document.getElementById('html-refresh').addEventListener('click', updatePreview);
document.getElementById('html-clear').addEventListener('click', function () {
  document.getElementById('html-input').value = '';
  document.getElementById('html-preview').innerHTML = '';
});

// Auto-refresh on input
document.getElementById('html-input').addEventListener('input', updatePreview);

// Initial render
updatePreview();
</script>
