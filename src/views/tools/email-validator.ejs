<div class="tool-page">
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://admatic.pro", "name": "AdMatic" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://admatic.pro/email-validator", "name": "Email Validator" } }
    ]
  }
  </script>

  <h1><%= t('tools.email_title') %></h1>
  <p class="description"><%= t('tools.email_desc') %></p>

  <div class="tool-widget">
    <div class="form-group">
      <label><%= t('tools.email_label') %></label>
      <input type="email" id="email-input" class="form-input" placeholder="user@example.com">
    </div>
    <button class="btn btn--primary" id="email-validate"><%= t('tools.email_btn') %></button>
  </div>

  <div class="tool-widget" id="email-result" style="display:none;">
    <div class="result-box" id="email-output"></div>
  </div>
</div>

<script>
document.getElementById('email-validate').addEventListener('click', function () {
  var email = document.getElementById('email-input').value.trim();
  var output = document.getElementById('email-output');
  var resultDiv = document.getElementById('email-result');

  if (!email) { output.textContent = 'Please enter an email address.'; output.className = 'result-box result-box--error'; resultDiv.style.display = 'block'; return; }

  // RFC 5322 simplified regex
  var regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  var isValid = regex.test(email);

  if (isValid) {
    output.textContent = '✓ ' + email + ' — valid format.';
    output.className = 'result-box result-box--success';
  } else {
    output.textContent = '✗ ' + email + ' — invalid format.';
    output.className = 'result-box result-box--error';
  }

  resultDiv.style.display = 'block';
});

// Validate on Enter
document.getElementById('email-input').addEventListener('keydown', function (e) {
  if (e.key === 'Enter') document.getElementById('email-validate').click();
});
</script>
