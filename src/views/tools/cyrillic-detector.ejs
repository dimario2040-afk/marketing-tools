<div class="tool-page">
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "item": { "@id": "https://admatic.pro", "name": "AdMatic" } },
      { "@type": "ListItem", "position": 2, "item": { "@id": "https://admatic.pro/cyrillic-detector", "name": "Cyrillic Detector" } }
    ]
  }
  </script>

  <h1><%= t('tools.cyrillic_title') %></h1>
  <p class="description"><%= t('tools.cyrillic_desc') %></p>

  <div class="tool-widget">
    <div class="form-group">
      <label><%= t('tools.cyrillic_label') %></label>
      <textarea id="cyr-input" class="form-textarea" rows="8" placeholder="Paste text containing Cyrillic characters…"></textarea>
    </div>
    <button class="btn btn--primary" id="cyr-check"><%= t('tools.cyrillic_btn') %></button>
  </div>

  <div class="tool-widget" id="cyr-result" style="display:none;">
    <h3><%= t('tools.cyrillic_analysis') %></h3>
    <p id="cyr-status"></p>
    <div id="cyr-highlight" class="result-box" style="white-space:pre-wrap;font-size:0.9rem;line-height:1.8;"></div>
  </div>
</div>

<script>
document.getElementById('cyr-check').addEventListener('click', function () {
  var text = document.getElementById('cyr-input').value;
  var result = document.getElementById('cyr-result');
  var status = document.getElementById('cyr-status');
  var highlight = document.getElementById('cyr-highlight');

  if (!text) { alert('Enter some text to check.'); return; }

  // Match Cyrillic ranges: U+0400–U+04FF, U+0500–U+052F, U+2DE0–U+2DFF, U+A640–U+A69F
  var cyrRegex = /[\u0400-\u04FF\u0500-\u052F\u2DE0-\u2DFF\uA640-\uA69F]/g;
  var matches = text.match(cyrRegex);
  var total = matches ? matches.length : 0;

  // Highlight Cyrillic chars by wrapping them in a span
  var highlighted = text.replace(cyrRegex, function (m) {
    return '<span style="background:#fef08a;color:#991b1b;font-weight:600;border-radius:2px;padding:0 1px;">' + m + '</span>';
  });

  var uniqueChars = matches ? [...new Set(matches)].join(', ') : 'none';

  status.innerHTML = 'Found <strong>' + total + '</strong> Cyrillic character' + (total !== 1 ? 's' : '') + '. ';
  if (total > 0) {
    status.innerHTML += 'Characters detected: <strong>' + uniqueChars + '</strong>';
    status.style.color = 'var(--color-warning)';
  } else {
    status.innerHTML += 'No Cyrillic characters detected.';
    status.style.color = 'var(--color-success)';
  }

  highlight.innerHTML = highlighted;
  result.style.display = 'block';
});
</script>
