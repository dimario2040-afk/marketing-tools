<div class="info-page">
  <h1><%= t('video_info.title') %></h1>
  <p><%= t('video_info.intro') %></p>

  <h2><%= t('video_info.free_title') %></h2>
  <table class="guide-table">
    <thead>
      <tr><th><%= t('video_info.free_th_tool') %></th><th><%= t('video_info.free_th_platform') %></th><th><%= t('video_info.free_th_best') %></th></tr>
    </thead>
    <tbody>
      <tr><td>DaVinci Resolve</td><td>Win / Mac</td><td>Professional colour grading and editing</td></tr>
      <tr><td>Shotcut</td><td>Win / Mac / Linux</td><td>Cross-platform open-source editing</td></tr>
      <tr><td>CapCut</td><td>Web / Mobile</td><td>Short-form social media videos</td></tr>
      <tr><td>Olive</td><td>Win / Mac / Linux</td><td>Lightweight alternative to Premiere Pro</td></tr>
      <tr><td>OpenShot</td><td>Win / Mac / Linux</td><td>Simple timeline-based editing</td></tr>
    </tbody>
  </table>

  <h2><%= t('video_info.paid_title') %></h2>
  <table class="guide-table">
    <thead>
      <tr><th><%= t('video_info.paid_th_tool') %></th><th><%= t('video_info.paid_th_price') %></th><th><%= t('video_info.paid_th_best') %></th></tr>
    </thead>
    <tbody>
      <tr><td>Adobe Premiere Pro</td><td>$23/mo</td><td>Professional production</td></tr>
      <tr><td>Final Cut Pro</td><td>$300 (one-time)</td><td>Mac-only high-performance editing</td></tr>
      <tr><td>Wondershare Filmora</td><td>$50/yr</td><td>Beginner-friendly with templates</td></tr>
      <tr><td>Canva Video</td><td>$13/mo</td><td>Quick social media videos with templates</td></tr>
    </tbody>
  </table>

  <h2><%= t('video_info.tips_title') %></h2>
  <ul>
    <li><%= t('video_info.tips_aspect') %></li>
    <li><%= t('video_info.tips_resolution') %></li>
    <li><%= t('video_info.tips_format') %></li>
    <li><%= t('video_info.tips_subtitles') %></li>
  </ul>
</div>

<style>
.info-page { max-width: 720px; margin: 0 auto; }
.info-page h1 { margin-bottom: 16px; }
.info-page h2 { margin-top: 32px; margin-bottom: 8px; }
.guide-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
.guide-table th, .guide-table td { padding: 8px 12px; text-align: left; border-bottom: 1px solid var(--color-border); font-size: 0.875rem; }
.guide-table th { background: var(--color-bg); font-weight: 600; }
.info-page ul { padding-left: 24px; margin-bottom: 16px; }
.info-page li { margin-bottom: 4px; }
</style>
