<div class="info-page">
  <script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "item": { "@id": "https://admatic.pro", "name": "AdMatic" } },
          { "@type": "ListItem", "position": 2, "item": { "@id": "https://admatic.pro/about", "name": "About" } }
        ]
      },
      {
        "@type": "AboutPage",
        "@id": "https://admatic.pro/about",
        "name": "About AdMatic",
        "description": "<%= t('about.p1').replace(/"/g, '&quot;') %>",
        "author": { "@type": "Person", "name": "Dmitriy Pechenkin" }
      }
    ]
  }
  </script>
  <h1><%= t('about.title') %></h1>
  <p><%= t('about.p1') %></p>

  <h2><%= t('about.why_title') %></h2>
  <p><%= t('about.why_text') %></p>

  <h2><%= t('about.what_title') %></h2>
  <ul>
    <li><%= t('about.what_url') %></li>
    <li><%= t('about.what_text') %></li>
    <li><%= t('about.what_validation') %></li>
    <li><%= t('about.what_media') %></li>
    <li><%= t('about.what_guides') %></li>
  </ul>

  <h2><%= t('about.tech_title') %></h2>
  <p><%= t('about.tech_text') %></p>
</div>

<style>
.info-page { max-width: 720px; margin: 0 auto; }
.info-page h1 { margin-bottom: 16px; }
.info-page h2 { margin-top: 32px; margin-bottom: 8px; }
.info-page ul { padding-left: 24px; margin-bottom: 16px; }
.info-page li { margin-bottom: 4px; }
</style>
